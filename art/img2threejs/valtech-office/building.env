# One building for img2threejs. Filled in by tools/new_building.sh; edit by hand afterwards.
NAME="Valtech Office"                 # target name in the spec
FACTORY="valtechOffice"           # lib/city/models/<FACTORY>.ts
REF="ref/plan-massing.png"     # layout + proportion target: plan_massing.py from the board numbers (Figma 576-3613)
[ "$BAY" = "1" ] && REF="ref/plan-massing-bay.png"   # the bay proof slice
STYLE="ref/ref-A-gemini.png"   # style + camera: AI reference A; facts: ref/photo-6.jpg (straight front), photo-1..3 (bridge)
FOOTPRINT_W=3               # tiles, docs/city-rules.md section 2
FOOTPRINT_H=2
