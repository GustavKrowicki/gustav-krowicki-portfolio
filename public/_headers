# Next.js puts a content hash in every file name under /_next/static/, so these never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Keep every workers.dev address of this Worker (the main one, previews, versions) out of search results.
# It never matches www.gustavkrowicki.com.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
